// Deep Research Schema
// Based on VISION.md - A framework for persistent, repeatable research

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// ENUMS - Validation States
// ============================================

enum AssertionStatus {
  CLAIM     // Default - unvalidated assertion
  EVIDENCE  // Human-validated assertion
  REJECTED  // Explicitly rejected by human
}

enum SourceStatus {
  PROPOSED   // Default - unvalidated source
  VALIDATED  // Human-validated source
  REJECTED   // Explicitly rejected by human
}

enum ResearchWorkflow {
  DISCOVERY  // Broad net, finding entities
  ANALYSIS   // Deep dive on specific entity
}

enum ExtractionStatus {
  PENDING    // Queued for extraction
  COMPLETED  // Successfully extracted
  FAILED     // Extraction failed
  STALE      // Data expired, needs refresh
}

enum AssertionCriticality {
  CRITICAL   // Must validate before conclusions - federal compliance, security architecture
  HIGH       // Should validate - pricing, integration claims
  MEDIUM     // Validate as time permits - feature claims, community metrics
  LOW        // Optional validation - general observations
}

enum SourceRelevance {
  DIRECT_EVIDENCE  // Source explicitly states/proves the assertion (5)
  STRONG_SUPPORT   // Source strongly supports with related evidence (4)
  PARTIAL_SUPPORT  // Source partially addresses the claim (3)
  WEAK_SUPPORT     // Source tangentially related (2)
  NOT_RELEVANT     // Source doesn't actually support the claim (1)
  MISLEADING       // Source was misinterpreted or contradicts claim (0)
}

enum SourceType {
  BLOG
  GITHUB_LIST
  GITHUB_TRENDING
  GITHUB_REPO
  NEWSLETTER
  AGGREGATOR
  REDDIT
  X_ACCOUNT
  X_SEARCH
  FORUM
  NEWS
  ACADEMIC
  DEV_COMMUNITY
}

enum CrawlStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================
// VALIDATION ENUMS - Adversarial Validation
// ============================================

enum ValidationVerdict {
  ROBUST        // Assertion withstands all challenges - safe to cite
  CONDITIONAL   // True only under specific conditions - requires qualifiers
  WEAK          // Evidence insufficient - needs more research
  REFUTED       // Counter-evidence disproves claim - do not cite
  UNVERIFIABLE  // Cannot be verified with available methods
}

enum ValidationConfidence {
  HIGH          // Strong evidence supporting the verdict
  MEDIUM        // Moderate evidence, some uncertainty
  LOW           // Limited evidence, significant uncertainty
  UNKNOWN       // Cannot assess confidence
}

enum ValidationMethod {
  ADVERSARIAL   // Systematic challenge via 5 attack vectors
  MANUAL        // Human review without structured challenge
  AUTOMATED     // Automated verification (link check, cite:verify)
  HYBRID        // Combination of automated and manual
}

// ============================================
// CORE MODELS
// ============================================

/// A research project/topic being investigated
model ResearchProject {
  id          String   @id @default(cuid())
  name        String
  description String?
  searchQuery String?  // The initial search criteria
  workflow    ResearchWorkflow @default(DISCOVERY)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entities    Entity[]

  @@map("research_projects")
}

/// An entity being researched (e.g., a tool, framework, product)
model Entity {
  id          String   @id @default(cuid())
  name        String
  description String?
  entityType  String?  // e.g., "tool", "framework", "product", "company"
  url         String?  // Primary URL for the entity
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Discovery categorization - which research category this entity belongs to
  // Values: ai_code_assistants, ai_code_review, ai_debugging, ai_testing,
  //         ai_documentation, ai_security, ai_devops, ai_analytics, genai_concepts
  // DEPRECATED: Use categoryId for new entities (LLM-based classification)
  discoveryCategory String?

  // New LLM-based categorization (replaces regex-based discoveryCategory)
  categoryId  String?
  category    DiscoveryCategory? @relation(fields: [categoryId], references: [id])

  // Domain-driven research - for research scoping
  domainId    String?
  domain      ResearchDomain? @relation(fields: [domainId], references: [id])

  // Logo/branding fields
  logoUrl        String?   // Direct URL to logo file (SVG preferred)
  logoPath       String?   // Local path to downloaded logo file
  logoFormat     String?   // "svg", "png", "jpg", "webp"
  logoSvgContent String?   // Raw SVG markup (stored inline for SVG logos)
  logoSourceUrl  String?   // URL where logo was found (press kit, brand page)
  logoFetchedAt  DateTime? // When logo was last fetched/verified
  logoVerified   Boolean   @default(false) // Human-verified as correct logo

  // GitHub metrics (auto-populated from GitHub API)
  githubUrl          String?   // GitHub repository URL
  githubOwner        String?   // Owner (org or user)
  githubRepo         String?   // Repository name
  githubStars        Int?      // Stargazer count
  githubForks        Int?      // Fork count
  githubWatchers     Int?      // Watcher count
  githubOpenIssues   Int?      // Open issue count
  githubContributors Int?      // Contributor count (top 100)
  githubLastCommit   DateTime? // Most recent commit date
  githubLastRelease  DateTime? // Most recent release date
  githubLanguage     String?   // Primary language
  githubLicense      String?   // License type (MIT, Apache-2.0, etc.)
  githubCreatedAt    DateTime? // Repo creation date
  githubMetricsAt    DateTime? // When metrics were last fetched

  // Buzz score (composite metric for stack-ranking)
  buzzScore          Float?    // Composite score 0.0-1.0
  buzzComponents     Json?     // Breakdown: {marketPresence, devActivity, funding, mentions, research}
  buzzCalculatedAt   DateTime? // When buzz was last calculated
  buzzOverride       Float?    // Manual override (researcher can hint buzz)
  buzzOverrideReason String?   // Why manual override was set

  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assertions       Assertion[]
  extractions      Extraction[]
  researchSessions ResearchSession[]

  @@unique([projectId, name])
  @@index([domainId])
  @@index([categoryId])
  @@map("entities")
}

/// An assertion/claim about an entity
model Assertion {
  id          String   @id @default(cuid())
  claim       String   // The assertion being made
  status      AssertionStatus @default(CLAIM)
  category    String?  // e.g., "feature", "pricing", "integration", "performance"
  confidence  Float?   // Optional confidence score (0-1) - how sure the AI is
  confidenceFactors Json?    // Breakdown of scoring factors (sources, quality, freshness, conflicts)
  lastValidatedAt   DateTime? // When confidence was last calculated
  validationHistory Json?    // History of validation attempts and score changes
  criticality AssertionCriticality @default(MEDIUM) // How important to conclusions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  validatedAt DateTime?
  validatedBy String?  // Human validator identifier

  // Human-in-the-loop validation fields
  citedInConclusion  Boolean  @default(false) // Is this assertion referenced in deliverables?
  conclusionContext  String?  // Where/how this assertion is used in conclusions
  rejectionReason    String?  // Why assertion was rejected (for re-research)
  supersededBy       String?  // ID of assertion that replaced this one after re-research

  // Conversational validation - human researcher dialogue
  humanResponse      String?  // Researcher's written response/interpretation
  validationNotes    Json?    // Array of {role: "human"|"agent", content: string, timestamp: Date}
  partiallyValidated Boolean  @default(false) // Some claims verified, others need work
  evidenceScreenshots Json? // Paths to screenshots uploaded as validation evidence (legacy) - stored as JSON array

  // Evidence-first research fields - screenshots as primary evidence
  evidenceChain      Json?    // Array of {screenshotPath, description, capturedAt} - agent-captured evidence
  evidenceDescription String? // Primary evidence description (what on screenshot supports claim)
  evidenceScreenshotPath String? // Primary evidence screenshot path

  // Discovery provenance - tracking how assertions were discovered
  discoverySourceId  String?   // Which discovery source first mentioned this
  firstDiscoveredAt  DateTime? // When first discovered in crawl
  mentionCount       Int       @default(1) // How many times mentioned across sources
  sourceSpread       Int       @default(1) // How many different sources mention this
  criticalityScore   Float?    // Computed criticality score (0-1)
  criticalityFactors Json?     // Breakdown of what makes this critical

  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  reasoning   Reasoning[]
  sources     AssertionSource[]
  validations ValidationResult[]

  @@index([criticality, status])
  @@index([citedInConclusion])
  @@index([discoverySourceId])
  @@map("assertions")
}

/// Reasoning supporting an assertion
model Reasoning {
  id          String   @id @default(cuid())
  content     String   // The reasoning/analysis
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assertionId String
  assertion   Assertion @relation(fields: [assertionId], references: [id], onDelete: Cascade)

  @@map("reasoning")
}

/// A source URL backing claims
model Source {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  description String?
  sourceType  String?  // e.g., "vendor_docs", "blog", "github", "forum", "press"
  status      SourceStatus @default(PROPOSED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  validatedAt DateTime?
  validatedBy String?  // Human validator identifier

  // URL validation fields (populated by extractor)
  lastFetchedAt   DateTime?  // When URL was last successfully fetched
  lastStatusCode  Int?       // HTTP status code from last fetch
  contentHash     String?    // Hash of page content for change detection
  isAccessible    Boolean    @default(true)

  assertions  AssertionSource[]
  extractions Extraction[]

  @@map("sources")
}

/// Many-to-many relationship between Assertions and Sources
/// Includes human grading of source relevance for research quality improvement
model AssertionSource {
  id          String   @id @default(cuid())
  quote       String?  // Relevant quote from the source
  createdAt   DateTime @default(now())

  // Source provenance - who added this source?
  addedBy     String?  // null = agent-added, "researcher-name" = human-added during validation

  // Human grading fields - used to improve agent citation behavior
  relevanceGrade  SourceRelevance?  // How relevant is this source to the assertion?
  annotation      String?           // Human notes explaining the grade
  gradedBy        String?           // Who graded this source
  gradedAt        DateTime?         // When it was graded

  assertionId String
  assertion   Assertion @relation(fields: [assertionId], references: [id], onDelete: Cascade)

  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([assertionId, sourceId])
  @@index([relevanceGrade])
  @@index([addedBy])
  @@map("assertion_sources")
}

/// Audit log for tracking research activities
model ResearchLog {
  id          String   @id @default(cuid())
  action      String   // e.g., "entity_created", "assertion_validated", "source_added"
  details     Json?    // Additional context
  agentId     String?  // Identifier for the subagent that performed the action
  createdAt   DateTime @default(now())

  @@map("research_logs")
}

// ============================================
// VALIDATION MODELS - Adversarial Assertion Validation
// ============================================

/// A structured validation result from adversarial validation
/// Supports multiple validations per assertion (history tracking)
model ValidationResult {
  id              String   @id @default(cuid())
  assertionId     String
  assertion       Assertion @relation(fields: [assertionId], references: [id], onDelete: Cascade)

  // Core verdict
  verdict         ValidationVerdict
  confidence      ValidationConfidence
  method          ValidationMethod

  // Refined claim (if original was imprecise or needed qualification)
  refinedClaim    String?

  // Attack vector results - structured JSON
  // Schema: {
  //   counterEvidence: {challenged: bool, finding?: string, severity?: string},
  //   evidenceGap: {challenged: bool, finding?: string, severity?: string},
  //   logicalFlaw: {challenged: bool, finding?: string, severity?: string},
  //   scopeLimitation: {challenged: bool, finding?: string, severity?: string},
  //   alternativeExplanation: {challenged: bool, finding?: string, severity?: string}
  // }
  attackResults   Json?

  // Counter-evidence with verified quotes
  // Schema: Array of {quote: string, sourceUrl: string, verified: bool, citeVerifyId?: string}
  counterEvidence Json?

  // Conditions (for CONDITIONAL verdicts)
  // Schema: Array of {condition: string, implication: string}
  conditions      Json?

  // Summary and recommendations
  summary         String?
  recommendations String?

  // Validator info
  validatorId     String   // Agent ID or researcher name
  validatedAt     DateTime @default(now())

  // Performance tracking
  durationMs      Int?     // How long validation took

  // Audit trail
  rawOutput       Json?    // Full validation output for debugging

  // Related citations verified during this validation
  citations       VerifiedCitation[]

  @@index([assertionId])
  @@index([verdict])
  @@index([validatedAt])
  @@map("validation_results")
}

/// A verified citation from the cite:verify tool
/// Persisted for audit trail, reuse, and cache
model VerifiedCitation {
  id              String   @id @default(cuid())
  url             String
  quote           String
  found           Boolean
  accessible      Boolean
  statusCode      Int?
  context         String?      // Surrounding text if found
  similarPhrases  Json?        // Array of similar text if exact not found
  recommendation  String       // "CITE", "PARAPHRASE", "DO_NOT_CITE", "PAGE_NOT_FOUND"
  reasoning       String?
  verifiedAt      DateTime @default(now())

  // Link to validation that used this citation
  validationResultId String?
  validationResult   ValidationResult? @relation(fields: [validationResultId], references: [id])

  @@index([url])
  @@index([validationResultId])
  @@map("verified_citations")
}

// ============================================
// EXTRACTION MODELS - Structured Data Capture
// ============================================

/// Screenshot evidence captured during extraction
model Screenshot {
  id          String   @id @default(cuid())
  filePath    String   // Local path to screenshot file
  url         String   // URL that was captured
  fullPage    Boolean  @default(true)
  width       Int?
  height      Int?
  capturedAt  DateTime @default(now())

  extractions Extraction[]

  @@map("screenshots")
}

/// Structured data extracted from a source
/// This is the PRIMARY tool for deep research - extracts queryable data from web pages
model Extraction {
  id            String   @id @default(cuid())
  schemaType    String   // "pricing", "features", "company", "compliance", "integrations", "custom"
  data          Json     // The structured data conforming to schema
  rawQuotes     Json?    // Supporting quotes from the source
  status        ExtractionStatus @default(COMPLETED)
  confidence    Float?   // LLM confidence in extraction (0-1)
  error         String?  // Error message if extraction failed
  extractedAt   DateTime @default(now())
  expiresAt     DateTime? // When this data should be re-extracted

  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  sourceId      String
  source        Source   @relation(fields: [sourceId], references: [id])

  screenshotId  String?
  screenshot    Screenshot? @relation(fields: [screenshotId], references: [id])

  // Auto-generated assertions from this extraction
  assertionIds  Json? // IDs of assertions created from this extraction - stored as JSON array

  @@index([entityId, schemaType])
  @@index([status])
  @@map("extractions")
}

// ============================================
// RESEARCH SESSION MODELS - Orchestrated Multi-Category Research
// ============================================

enum ResearchSessionStatus {
  INITIALIZING  // Session created, tasks not yet generated
  PLANNING      // Tasks being planned/generated
  RESEARCHING   // Active research in progress
  PAUSED        // Session temporarily paused
  COMPLETED     // All tasks completed successfully
  FAILED        // Session failed with errors
  CANCELLED     // Session cancelled by user
}

enum ResearchTaskStatus {
  PENDING       // Task queued, not yet started
  IN_PROGRESS   // Task currently being executed
  COMPLETED     // Task completed successfully
  FAILED        // Task failed with error
  CANCELLED     // Task cancelled by user
  PAUSED        // Task temporarily paused
}

/// A research session orchestrating multi-category deep research on an entity
model ResearchSession {
  id                  String   @id @default(cuid())
  entityId            String
  projectId           String
  researcherName      String   // Name of the researcher/agent managing this session
  status              ResearchSessionStatus @default(INITIALIZING)
  createdAt           DateTime @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  pausedAt            DateTime?

  // Research configuration
  categories          Json? // e.g., ["pricing", "features", "compliance"] - stored as JSON array
  mode                String   // "sequential" or "parallel"
  config              Json?    // Full ResearchSessionConfig object

  // Progress tracking
  overallProgress     Json?    // Aggregated SessionProgress object
  totalTasks          Int      @default(0)
  completedTasks      Int      @default(0)
  failedTasks         Int      @default(0)

  // Research output metrics
  totalAssertions     Int      @default(0)
  totalScreenshots    Int      @default(0)
  totalExtractions    Int      @default(0)

  // Relations
  entity              Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tasks               ResearchTask[]

  @@index([entityId])
  @@index([projectId])
  @@index([status])
  @@map("research_sessions")
}

/// An individual research task within a session
model ResearchTask {
  id          String   @id @default(cuid())
  sessionId   String
  category    String   // "pricing", "features", "company", "compliance", "integrations"
  status      ResearchTaskStatus @default(PENDING)
  agentId     String?  // ID of the agent working on this task
  startedAt   DateTime?
  completedAt DateTime?
  error       String?  // Error message if task failed

  // Task progress and results
  progress    Json?    // TaskProgress object
  results     Json?    // TaskResults object

  // Relations
  session     ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([category])
  @@map("research_tasks")
}

// ============================================
// DISCOVERY MODELS - Systematic Source Crawling
// ============================================

/// A curated information source for discovery crawling
model DiscoverySource {
  id              String   @id @default(cuid())
  name            String   @unique
  url             String
  sourceType      SourceType
  category        String   // "blogs", "github", "reddit", "x", "newsletters", etc.

  // Crawl configuration
  crawlStrategy   String   // "rss", "json_api", "html_scrape", "nitter_rss", "hn_api", "github_api"
  crawlFrequency  String   // "hourly", "daily", "weekly"
  crawlDepth      Int      @default(1)
  selectors       Json?    // CSS selectors for HTML scraping
  feedUrl         String?  // RSS/Atom feed URL
  apiEndpoint     String?  // API endpoint

  // Crawl state
  lastCrawledAt   DateTime?
  lastSuccessAt   DateTime?
  lastError       String?
  consecutiveErrors Int     @default(0)
  isActive        Boolean  @default(true)

  // Quality metrics
  discoveriesCount Int     @default(0)
  validatedCount  Int      @default(0)
  hitRate         Float?
  avgNoveltyScore Float?

  // Metadata
  description     String?
  tags            Json? // stored as JSON array
  priority        Int       @default(50)

  discoveries     RawDiscovery[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceType])
  @@index([lastCrawledAt])
  @@index([isActive, priority])
  @@map("discovery_sources")
}

/// A raw discovery from a source before deduplication
model RawDiscovery {
  id              String   @id @default(cuid())
  sourceId        String
  source          DiscoverySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // Discovery content
  mentionedName   String
  briefDescription String?
  discoveryUrl    String
  contextSnippet  String?

  // Extracted metadata
  extractedLinks  Json? // stored as JSON array
  releaseVersion  String?
  releaseDate     DateTime?
  keywords        Json? // stored as JSON array

  // Discovery metadata
  discoveredAt    DateTime @default(now())
  crawlSessionId  String

  // Processing state
  processed       Boolean  @default(false)
  matchedEntityId String?
  createdEntityId String?

  // Scoring
  noveltyScore    Float?
  relevanceScore  Float?

  @@index([sourceId, discoveredAt])
  @@index([processed])
  @@index([mentionedName])
  @@map("raw_discoveries")
}

/// A crawl session for tracking progress
model DiscoveryCrawl {
  id              String   @id @default(cuid())
  projectId       String?

  // Scope
  sourceIds       Json? // stored as JSON array
  researchFocus   String?

  // Timing
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  pausedAt        DateTime?

  // Progress
  status          CrawlStatus @default(IN_PROGRESS)
  sourcesTotal    Int
  sourcesComplete Int      @default(0)
  sourcesFailed   Int      @default(0)

  // Results
  discoveriesFound Int     @default(0)
  entitiesCreated Int      @default(0)
  entitiesUpdated Int      @default(0)
  trendsDetected  Int      @default(0)

  // Resumability
  checkpoint      Json?

  @@index([status])
  @@index([startedAt])
  @@map("discovery_crawls")
}

/// A detected trend across discoveries
model DiscoveryTrend {
  id              String   @id @default(cuid())
  projectId       String?

  name            String
  description     String?
  category        String?

  // Metrics
  mentionCount    Int      @default(0)
  entityCount     Int      @default(0)
  sourceSpread    Int      @default(0)
  velocity        Float?

  // Temporal
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  peakAt          DateTime?

  // Related data
  entityIds       Json? // stored as JSON array
  keywords        Json? // stored as JSON array

  // Scoring
  trendScore      Float?
  emergingScore   Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([trendScore])
  @@map("discovery_trends")
}

// ============================================
// DISCOVERY CATEGORY MODELS - LLM-Based Entity Classification
// ============================================

/// A category definition for LLM-based entity classification
/// Replaces regex-based classification with semantic understanding
model DiscoveryCategory {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g., "ai_code_assistants"
  displayName String             // e.g., "Code Assistants"
  description String     // Rich text definition

  // Classification guidance for LLM
  inclusionCriteria  String?    // What qualifies an entity for this category
  exclusionCriteria  String?    // What disqualifies an entity
  exemplarEntities   Json?           // Example entities that belong here - stored as JSON array
  antiExemplars      Json?           // Entities that might seem to fit but don't - stored as JSON array

  // Metadata
  entityCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  entities    Entity[]

  @@map("discovery_categories")
}

// ============================================
// RESEARCH DOMAIN MODELS - Flexible Domain-Driven Research
// ============================================

/// A research domain defining what to discover and how to find it
model ResearchDomain {
  id                  String   @id @default(cuid())
  name                String   @unique  // e.g., "Agentic-SDLC-Tools"
  description         String   // What this domain covers

  // What to find
  entityTypes         Json? // ["tool", "framework", "platform"] - stored as JSON array
  inclusionCriteria   String?  // Markdown: what qualifies an entity
  exclusionCriteria   String?  // Markdown: what disqualifies

  // How to find it (Claude uses these to generate queries)
  searchHints         String?  // Guidance for query generation
  knownLeaders        Json? // Known tools for "[X] alternatives" searches - stored as JSON array
  relevantTopics      Json? // Topics to explore - stored as JSON array

  // How to evaluate (for scoring discovered entities)
  evaluationDimensions Json?   // [{name: "differentiation", weight: 0.3}, ...]

  // Tracking
  lastDiscoveryAt     DateTime?
  entityCount         Int      @default(0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?

  // Relations
  entities            Entity[]

  @@map("research_domains")
}
