{
  "name": "deep-research",
  "version": "1.0.0",
  "description": "Deep Research - Repeatable and Persistent research framework with SQLite",
  "main": "dist/tools/index.js",
  "types": "dist/tools/index.d.ts",
  "scripts": {
    "setup": "bash install.sh",
    "build": "tsc",
    "cli": "ts-node --transpile-only src/cli.ts",
    "server": "ts-node src/server/index.ts",
    "server:dev": "nodemon --watch src/server -e ts,tsx --exec ts-node src/server/index.ts",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:check": "cd frontend && npm run check",
    "dev": "concurrently \"npm run server:dev\" \"npm run frontend:dev\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:migrate-from-pg": "ts-node --transpile-only scripts/migrate-pg-to-sqlite.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristopherGRoge/Tools-Efficacy.git"
  },
  "keywords": [
    "research",
    "prisma",
    "postgresql",
    "claude-code"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ChristopherGRoge/Tools-Efficacy/issues"
  },
  "homepage": "https://github.com/ChristopherGRoge/Tools-Efficacy#readme",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.11",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.19.7",
    "@hono/node-ws": "^1.2.0",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.3.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^17.2.3",
    "hono": "^4.11.3",
    "pg": "^8.16.3",
    "playwright": "^1.49.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.0"
  }
}
