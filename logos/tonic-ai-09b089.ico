class="marquee_logo"/></div><div role="listitem" class="logo_item w-dyn-item u-vflex-center-center"><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/6769826cc63014058d4f7773_logo_betterhelp.svg" alt="" class="marquee_logo"/></div><div role="listitem" class="logo_item w-dyn-item u-vflex-center-center"><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/67697f83cd0e3fbcf98df4bd_logo_oxbury.svg" alt="" class="marquee_logo"/></div><div role="listitem" class="logo_item w-dyn-item u-vflex-center-center"><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/67697f67a7fffeda5f0fb8c3_logo_flywire.svg" alt="" class="marquee_logo"/></div><div role="listitem" class="logo_item w-dyn-item u-vflex-center-center"><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/692f4b8d2a4ef40ddd5dc1dd_superdial.svg" alt="" class="marquee_logo"/></div><div role="listitem" class="logo_item w-dyn-item u-vflex-center-center"><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/6769b7c9f014a0b343588248_logo_wellthy%201.svg" alt="" class="marquee_logo"/></div><div role="listitem" class="logo_item w-dyn-item u-vflex-center-center"><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/6769b1b06de54450a2868644_logo_hinge-health.svg" alt="" class="marquee_logo"/></div><div role="listitem" class="logo_item w-dyn-item u-vflex-center-center"><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/6769abe676ad5ff511713a7d_logo_velocity-global.svg" alt="" class="marquee_logo"/></div></div></div><div class="u-embed-js w-embed w-script"><script>
pageFunctions.addFunction('logoGridRandomRotation', function() {
  const container = document.querySelector('.logos_grid');
  if (!container) return;

  const allItems = Array.from(container.querySelectorAll('.logo_item'));

  const allLogosData = allItems
    .map(item => {
      const img = item.querySelector('.marquee_logo');
      if (!img) return null;
      return {
        src: img.getAttribute('src'),
        srcset: img.getAttribute('srcset'),
        sizes: img.getAttribute('sizes'),
        alt: img.getAttribute('alt') || ''
      };
    })
    .filter(Boolean);

  const TOTAL = allLogosData.length;
  const VISIBLE_COUNT = Math.min(18, TOTAL); // adjust if needed

  if (TOTAL <= VISIBLE_COUNT) {
    // Not enough logos to rotate
    return;
  }

  // Use first N items as visible slots
  const slots = allItems.slice(0, VISIBLE_COUNT);

  // Hide the remaining CMS items (used only as data pool)
  const poolItems = allItems.slice(VISIBLE_COUNT);
  poolItems.forEach(item => {
    item.style.display = 'none';
  });

  const usedIndices = new Set();
  const fadeDuration = 300; // must match CSS
  const minInterval = 800;
  const maxInterval = 1600;

  function setLogo(imgEl, data) {
    imgEl.setAttribute('src', data.src);
    if (data.srcset) imgEl.setAttribute('srcset', data.srcset);
    if (data.sizes) imgEl.setAttribute('sizes', data.sizes);
    imgEl.setAttribute('alt', data.alt);
  }

  // Initial fill
  slots.forEach(slot => {
    const img = slot.querySelector('.marquee_logo');
    if (!img) return;

    let index;
    do {
      index = Math.floor(Math.random() * TOTAL);
    } while (usedIndices.has(index));

    usedIndices.add(index);
    setLogo(img, allLogosData[index]);
    slot.dataset.logoIndex = String(index);
  });

  function getAvailableIndices() {
    const available = [];
    for (let i = 0; i < TOTAL; i++) {
      if (!usedIndices.has(i)) available.push(i);
    }
    return available;
  }

  function swapOneLogo() {
    const freeSlots = slots.filter(slot => !slot.dataset.animating);
    if (!freeSlots.length) return;

    const slot = freeSlots[Math.floor(Math.random() * freeSlots.length)];
    const img = slot.querySelector('.marquee_logo');
    if (!img) return;

    const currentIndex = parseInt(slot.dataset.logoIndex || '0', 10);
    const available = getAvailableIndices();
    if (!available.length) return;

    const newIndex = available[Math.floor(Math.random() * available.length)];
    const newData = allLogosData[newIndex];

    slot.dataset.animating = '1';
    slot.classList.add('is-fading-out');

    setTimeout(function () {
      // Swap logo once faded out
      usedIndices.delete(currentIndex);
      usedIndices.add(newIndex);
      setLogo(img, newData);
      slot.dataset.logoIndex = String(newIndex);

      slot.classList.remove('is-fading-out');
      slot.classList.add('is-fading-in');

      setTimeout(function () {
        slot.classList.remove('is-fading-in');
        delete slot.dataset.animating;
      }, fadeDuration);
    }, fadeDuration);
  }

  function scheduleNextSwap() {
    const delay = Math.random() * (maxInterval - minInterval) + minInterval;
    setTimeout(function () {
      swapOneLogo();
      scheduleNextSwap();
    }, delay);
  }

  scheduleNextSwap();
});
</script>
<style>
  .logo_item {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .logo_item.is-fading-out {
    opacity: 0;
    transform: scale(0.96);
  }

  .logo_item.is-fading-in {
    opacity: 1;
    transform: scale(1);
  }
</style></div></div></section><section class="products_scroll_wrapper"><div data-padding-top="none" class="products_scroll_container u-container u-position-relative u-vflex-center-top u-width-full"><div data-padding-bottom="none" data-padding-top="none" class="u-container-small"><h2 class="u-text-style-h2 u-text-align-center">Data synthesis for every stage of development, testing, and AI model training</h2></div><div data-padding-top="1.5" data-padding-bottom="main" class="products_stack u-position-relative u-overflow-clip"><div class="product_scroll_card"><div class="product_stack_card u-radius-small u-overflow-clip u-zindex-2"><div class="card is-white padding-sm u-radius-none u-vflex-stretch-top"><div class="image_wrap u-vflex-left-top"><img src="https://cdn.prod.website-files.com/62e28cf08913e81176ba2c39/691cdce9e4baff2854681ff2_TonicFabricate-Horizontal-Dark-Icon.svg" loading="lazy" alt="" class="logo is-max_height is-1-5rem"/></div><div data-padding-top="x-small" class="content_wrap"><h3 class="u-text-style-h3">Generate synthetic data from scratch</h3><p class="inline_size_small_p">Turbocharge new product development and AI model training with fully relational synthetic databases, realistic unstructured data, and mock APIs generated at scale and on demand.</p></div><div data-padding-bottom="1.5" data-padding-top="1.5" class="button_wrap u-hflex-left-center u-gap-gutter u-hflex-wrap"><div data-padding-top="" class="button-primary-wrapper"><a data-wf-native-id-path="278ab5e1-dc74-33cb-ebe0-9dfcd1ecb96a:278ab5e1-dc74-33cb-ebe0-9dfcd1ecb972:481b31da-8fd2-456a-f42b-7296f4223054:481b31da-8fd2-456a-f42b-7296f4223051" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="481b31da-8fd2-456a-f42b-7296f4223051" data-wf-component-context="%5B%7B%22componentId%22%3A%22278ab5e1-dc74-33cb-ebe0-9dfcd1ecb96b%22%2C%22instanceId%22%3A%22278ab5e1-dc74-33cb-ebe0-9dfcd1ecb96a%22%7D%2C%7B%22componentId%22%3A%22c3da83e4-b293-2fc5-e0aa-fe2a3aeacd01%22%2C%22instanceId%22%3A%2