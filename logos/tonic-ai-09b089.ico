6568-5d8b-141a-4376-c865d85a03c0:c1ed6568-5d8b-141a-4376-c865d85a03fb:481b31da-8fd2-456a-f42b-7296f4223051" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="481b31da-8fd2-456a-f42b-7296f4223051" data-wf-component-context="%5B%7B%22componentId%22%3A%22c1ed6568-5d8b-141a-4376-c865d85a03c1%22%2C%22instanceId%22%3A%22c1ed6568-5d8b-141a-4376-c865d85a03c0%22%7D%2C%7B%22componentId%22%3A%22481b31da-8fd2-456a-f42b-7296f4223050%22%2C%22instanceId%22%3A%22c1ed6568-5d8b-141a-4376-c865d85a03fb%22%7D%5D" href="https://trust.tonic.ai/" data-wf-event-ids="" class="button-primary is-small_primary w-inline-block  "><div class="u-text-style-small margin-none u-weight-medium">Explore our security posture</div></a></div></div></div></div><div class="u-embed-css w-embed"><style>
	.w-background-video video{
  	inset: 0%; !important
  }
  /* Accordion content (collapsed by default) */
.industry_nav_content {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, opacity 0.35s ease;
}

.industry_nav_content p{
  color: #b3b3b4;
}

/* When parent button is active */
.industry_tab_link.is-active .industry_nav_content {
  opacity: 1;
  max-height: 400px; /* big enough for your tallest panel */
}

/* Video fade */
.industry_bg_video {
  position: absolute; /* or relative + stack however you prefer */
  inset: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
}

.industry_bg_video.is-active {
  opacity: 1;
  pointer-events: auto;
}
/* default state */
.industry_tab_link .icon {
  color: #ffffff;
  transition: color 0.25s ease, fill 0.25s ease, stroke 0.25s ease;
}

/* hover + active states */
.industry_tab_link:hover .icon,
.industry_tab_link:focus-visible .icon,
.industry_tab_link.is-active .icon {
  color: #00DCDC;
}
/* default state */
.industry_tab_link {
  background-color: transparent; /* or whatever your base is */
  transition: background-color 0.25s ease, border-color 0.25s ease;
}

/* hover + active states */
.industry_tab_link:hover,
.industry_tab_link:focus-visible,
.industry_tab_link.is-active {
  background-color: #1a1e27;
}
</style></div><div class="u-embed-js w-embed w-script"><script>
pageFunctions.addFunction('industryAccordion', function() {
  var nav = document.querySelector('.industry_nav');
  var buttons = nav ? nav.querySelectorAll('.industry_tab_link') : [];
  var videos = document.querySelectorAll('.industry_bg_video');

  if (!buttons.length || !videos.length) return;

  function getVideoForButton(btn) {
    // Prefer explicit data attribute
    var vidId = btn.getAttribute('data-video-id');

    // Fallback: derive from ID (healthcare-btn -> healthcare-vid)
    if (!vidId) {
      var btnId = btn.id || '';
      if (!btnId) return null;
      vidId = btnId.replace('-btn', '-vid');
    }

    return document.getElementById(vidId);
  }

  function collapseAll() {
    buttons.forEach(function(b) {
      b.classList.remove('is-active');
      var content = b.querySelector('.industry_nav_content');
      if (content) {
        content.style.maxHeight = null;
        content.classList.remove('is-open');
      }
    });

    videos.forEach(function(v) {
      v.classList.remove('is-active');
    });
  }

  function activateButton(btn) {
    if (!btn) return;

    collapseAll();

    // Activate button + expand content
    btn.classList.add('is-active');
    var content = btn.querySelector('.industry_nav_content');
    if (content) {
      content.classList.add('is-open');
      // Use scrollHeight so transition animates to exact height
      content.style.maxHeight = content.scrollHeight + 'px';
    }

    // Activate matching video
    var vidWrapper = getVideoForButton(btn);
    if (vidWrapper) {
      vidWrapper.classList.add('is-active');

      var vidEl = vidWrapper.querySelector('video');
      if (vidEl) {
        try {
          vidEl.currentTime = 0;
          vidEl.play();
        } catch (e) {
          // ignore autoplay errors
        }
      }
    }
  }

  // Init: use existing .is-active or default to first
  var initial =
    nav.querySelector('.industry_tab_link.is-active') || buttons[0];
  activateButton(initial);

  // Click handlers
  buttons.forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();

      // If you *don’t* want toggle close, early-return when already active
      if (btn.classList.contains('is-active')) return;

      activateButton(btn);
    });
  });

  // Optional: keep accordion heights correct on resize
  window.addEventListener('resize', function() {
    var activeBtn = nav.querySelector('.industry_tab_link.is-active');
    if (!activeBtn) return;

    var content = activeBtn.querySelector('.industry_nav_content');
    if (content && content.classList.contains('is-open')) {
      content.style.maxHeight = content.scrollHeight + 'px';
    }
  });
});
</script></div></div></section><section data-padding-top="" class="reviews_wrapper"><div data-padding-bottom="none" data-padding-top="large" class="u-container-small"><h2 class="u-text-style-h2 u-text-align-center">We&#x27;re proud recipients of glowing reviews from our customers</h2></div><div class="reviews_container u-vflex-stretch-center u-gap-gutter"><div class="reviews_mover_left"><div class="reviews_wrapper_left w-dyn-list"><div role="list" class="reviews_marquee_left w-dyn-items"><div role="listitem" class="review_item w-dyn-item u-position-relative"><a data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d8b_instance-0" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="318937f0-ae3d-0d73-ff2e-91d0fabf8d8b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%226825feb81aea2b1c78196c3c%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%5D" href="https://www.tonic.ai/case-study/ai-roadblock-breakthrough-wellthy-transformed-healthcare-with-tonic" target="_blank" class="resource_link u-position-absolute w-inline-block"></a><div class="card is-white is-marquee_review u-zindex-2 u-vflex-left-between u-height-full u-width-full"><div class="u-hflex-left-center w-condition-invisible u-gap-gutter"><img loading="lazy" src="https://cdn.prod.website-files.com/plugins/Basic/assets/placeholder.60f9b1840c.svg" alt="" class="logo is-max_height is-2rem w-dyn-bind-empty"/><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e81176ba2c39/691f88d258686e57206b32c2_5stars.svg" alt="" class="logo is-max_height is-2rem"/></div><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/6825fb9d72c16dbabc6ec148_wellthy-logo.svg" alt="" class="logo is-max_height is-2rem"/><div data-padding-top="1.5" class="u-vflex-left-center"><div class="u-text-style-small">“Without a solution for secure, realistic test data, many of our new AI features simply wouldn&#x27;t have been possible. With Tonic Textual, we can now confidently build and test these features without exposing PII, all while maintaining the rigorous privacy standards we hold ourselves accountable to as a healthcare company serving millions of families.”</div></div><div data-padding-top="main" class="u-hflex-between-bottom u-overflow-clip u-width-full"><div class="u-vflex-left-bottom"><div class="u-text-style-small margin-none u-weight-medium">Kevin Roche</div><div class="u-text-style-tiny margin-none">Co-founder and CTO of Wellthy</div></div><div class="button_wrap"><a href="https://www.tonic.ai/case-study/ai-roadblock-breakthrough-wellthy-transformed-healthcare-with-tonic" aria-label="" data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d98_instance-0:c3a0ee47-85f2-8410-3ea0-5b3d476c853b_instance-0" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="c3a0ee47-85f2-8410-3ea0-5b3d476c853b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%226825feb81aea2b1c78196c3c%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%2C%7B%22componentId%22%3A%22c3a0ee47-85f2-8410-3ea0-5b3d476c853b%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d98%22%7D%5D" class="underline-button w-button">Read review</a></div></div></div><div class="active_cs_outline is-reviews_outline u-radius-small u-cover-absolute"></div></div><div role="listitem" class="review_item w-dyn-item u-position-relative"><a data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d8b_instance-1" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="318937f0-ae3d-0d73-ff2e-91d0fabf8d8b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%2267c5cada2882ade2a51eed13%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%5D" href="https://www.tonic.ai/case-study/how-flexport-protects-its-data-and-empowers-its-developers-with-tonic" target="_blank" class="resource_link u-position-absolute w-inline-block"></a><div class="card is-white is-marquee_review u-zindex-2 u-vflex-left-between u-height-full u-width-full"><div class="u-hflex-left-center w-condition-invisible u-gap-gutter"><img loading="lazy" src="https://cdn.prod.website-files.com/plugins/Basic/assets/placeholder.60f9b1840c.svg" alt="" class="logo is-max_height is-2rem w-dyn-bind-empty"/><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e81176ba2c39/691f88d258686e57206b32c2_5stars.svg" alt="" class="logo is-max_height is-2rem"/></div><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/63d03b9efdcc392216171b15_62e28cf08913e8038cba2c64_604d41842582aa8383e765ce_logoDefault.avif" alt="" class="logo is-max_height is-2rem"/><div data-padding-top="1.5" class="u-vflex-left-center"><div class="u-text-style-small">“Our security team loves it because it solves a complex problem crucial to reducing risk for our company. Infrastructure loves it because it’s on-prem and easily deployed in a container. And our engineers love it because it’s easy to use and integrates seamlessly into our software development lifecycle without asking them to do any extra work. That’s a huge win for us, equipping us with the real security we need to meet compliance obligations and safeguard our customer&#x27;s privacy.”</div></div><div data-padding-top="main" class="u-hflex-between-bottom u-overflow-clip u-width-full"><div class="u-vflex-left-bottom"><div class="u-text-style-small margin-none u-weight-medium">Kevin Paige</div><div class="u-text-style-tiny margin-none">Chief Information Security Officer</div></div><div class="button_wrap"><a href="https://www.tonic.ai/case-study/how-flexport-protects-its-data-and-empowers-its-developers-with-tonic" aria-label="" data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d98_instance-1:c3a0ee47-85f2-8410-3ea0-5b3d476c853b_instance-1" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="c3a0ee47-85f2-8410-3ea0-5b3d476c853b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%2267c5cada2882ade2a51eed13%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%2C%7B%22componentId%22%3A%22c3a0ee47-85f2-8410-3ea0-5b3d476c853b%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d98%22%7D%5D" class="underline-button w-button">Read review</a></div></div></div><div class="active_cs_outline is-reviews_outline u-radius-small u-cover-absolute"></div></div><div role="listitem" class="review_item w-dyn-item u-position-relative"><a data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d8b_instance-2" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="318937f0-ae3d-0d73-ff2e-91d0fabf8d8b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%22679a47076dc37938485ae813%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%5D" href="https://www.tonic.ai/case-study/patterson-test-data-better-software-for-thousands" target="_blank" class="resource_link u-position-absolute w-inline-block"></a><div class="card is-white is-marquee_review u-zindex-2 u-vflex-left-between u-height-full u-width-full"><div class="u-hflex-left-center w-condition-invisible u-gap-gutter"><img loading="lazy" src="https://cdn.prod.website-files.com/plugins/Basic/assets/placeholder.60f9b1840c.svg" alt="" class="logo is-max_height is-2rem w-dyn-bind-empty"/><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e81176ba2c39/691f88d258686e57206b32c2_5stars.svg" alt="" class="logo is-max_height is-2rem"/></div><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/679ce20f68a0193a5de55055_Patterson%20logo.avif" alt="" class="logo is-max_height is-2rem"/><div data-padding-top="1.5" class="u-vflex-left-center"><div class="u-text-style-small">“Tonic has been incredibly user-friendly, providing the features we needed to scale our performance testing. What once took nearly two and a half hours to generate the test data we need, now takes just 35 to 45 minutes, end-to-end.”</div></div><div data-padding-top="main" class="u-hflex-between-bottom u-overflow-clip u-width-full"><div class="u-vflex-left-bottom"><div class="u-text-style-small margin-none u-weight-medium">Debarati Mukhopadhyay</div><div class="u-text-style-tiny margin-none">Principal Performance Engineer</div></div><div class="button_wrap"><a href="https://www.tonic.ai/case-study/patterson-test-data-better-software-for-thousands" aria-label="" data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d98_instance-2:c3a0ee47-85f2-8410-3ea0-5b3d476c853b_instance-2" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="c3a0ee47-85f2-8410-3ea0-5b3d476c853b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%22679a47076dc37938485ae813%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%2C%7B%22componentId%22%3A%22c3a0ee47-85f2-8410-3ea0-5b3d476c853b%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d98%22%7D%5D" class="underline-button w-button">Read review</a></div></div></div><div class="active_cs_outline is-reviews_outline u-radius-small u-cover-absolute"></div></div><div role="listitem" class="review_item w-dyn-item u-position-relative"><a data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d8b_instance-3" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="318937f0-ae3d-0d73-ff2e-91d0fabf8d8b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%2267c5c73cc41bfb8989f62ce6%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%5D" href="https://www.tonic.ai/case-study/hundreds-of-hours-of-development-time-saved-leads-paytient-to-significant-roi-with-tonic-cloud" target="_blank" class="resource_link u-position-absolute w-inline-block"></a><div class="card is-white is-marquee_review u-zindex-2 u-vflex-left-between u-height-full u-width-full"><div class="u-hflex-left-center w-condition-invisible u-gap-gutter"><img loading="lazy" src="https://cdn.prod.website-files.com/plugins/Basic/assets/placeholder.60f9b1840c.svg" alt="" class="logo is-max_height is-2rem w-dyn-bind-empty"/><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e81176ba2c39/691f88d258686e57206b32c2_5stars.svg" alt="" class="logo is-max_height is-2rem"/></div><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/652444d2456b31c27d3269b3_paytient%20logo.avif" alt="" class="logo is-max_height is-2rem"/><div data-padding-top="1.5" class="u-vflex-left-center"><div class="u-text-style-small">&quot;If I think about what it would cost for us to build something even remotely viable for us to solve our test data problem in the way that Tonic has solved it for us, it&#x27;s orders of magnitude more than what it costs us to run Tonic Cloud.&quot;</div></div><div data-padding-top="main" class="u-hflex-between-bottom u-overflow-clip u-width-full"><div class="u-vflex-left-bottom"><div class="u-text-style-small margin-none u-weight-medium">Jordan Stone</div><div class="u-text-style-tiny margin-none">VP of Engineering</div></div><div class="button_wrap"><a href="https://www.tonic.ai/case-study/hundreds-of-hours-of-development-time-saved-leads-paytient-to-significant-roi-with-tonic-cloud" aria-label="" data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d98_instance-3:c3a0ee47-85f2-8410-3ea0-5b3d476c853b_instance-3" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="c3a0ee47-85f2-8410-3ea0-5b3d476c853b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%2267c5c73cc41bfb8989f62ce6%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%2C%7B%22componentId%22%3A%22c3a0ee47-85f2-8410-3ea0-5b3d476c853b%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d98%22%7D%5D" class="underline-button w-button">Read review</a></div></div></div><div class="active_cs_outline is-reviews_outline u-radius-small u-cover-absolute"></div></div><div role="listitem" class="review_item w-dyn-item u-position-relative"><a data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d8b_instance-4" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="318937f0-ae3d-0d73-ff2e-91d0fabf8d8b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%2264beea08e8bd5cee590e423a%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%5D" href="https://www.tonic.ai/case-study/enabling-csa-star-certification-and-developer-outsourcing-at-bluedrop-learning-networks" target="_blank" class="resource_link u-position-absolute w-inline-block"></a><div class="card is-white is-marquee_review u-zindex-2 u-vflex-left-between u-height-full u-width-full"><div class="u-hflex-left-center w-condition-invisible u-gap-gutter"><img loading="lazy" src="https://cdn.prod.website-files.com/plugins/Basic/assets/placeholder.60f9b1840c.svg" alt="" class="logo is-max_height is-2rem w-dyn-bind-empty"/><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e81176ba2c39/691f88d258686e57206b32c2_5stars.svg" alt="" class="logo is-max_height is-2rem"/></div><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/63d03b9d70079f62f2dd75fd_62e28cf08913e8d6caba2c53_604d3f01314d35dfbde795ab_bluedrop.avif" alt="" class="logo is-max_height is-2rem"/><div data-padding-top="1.5" class="u-vflex-left-center"><div class="u-text-style-small">“We selected Tonic as our preferred vendor due to its plethora of advanced features, better UX, faster time to value, and lower total cost of ownership than any of the alternatives.”</div></div><div data-padding-top="main" class="u-hflex-between-bottom u-overflow-clip u-width-full"><div class="u-vflex-left-bottom"><div class="u-text-style-small margin-none u-weight-medium">Donal Mac An Ri</div><div class="u-text-style-tiny margin-none">Architecture Team Lead</div></div><div class="button_wrap"><a href="https://www.tonic.ai/case-study/enabling-csa-star-certification-and-developer-outsourcing-at-bluedrop-learning-networks" aria-label="" data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d98_instance-4:c3a0ee47-85f2-8410-3ea0-5b3d476c853b_instance-4" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="c3a0ee47-85f2-8410-3ea0-5b3d476c853b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%2264beea08e8bd5cee590e423a%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%2C%7B%22componentId%22%3A%22c3a0ee47-85f2-8410-3ea0-5b3d476c853b%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d98%22%7D%5D" class="underline-button w-button">Read review</a></div></div></div><div class="active_cs_outline is-reviews_outline u-radius-small u-cover-absolute"></div></div><div role="listitem" class="review_item w-dyn-item u-position-relative"><a data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d8b_instance-5" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="318937f0-ae3d-0d73-ff2e-91d0fabf8d8b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%2264beea08e8bd5cee590e4247%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%5D" href="https://www.tonic.ai/case-study/how-alegeus-shortens-sprints-to-deploy-healthtech-at-speed-with-tonic" target="_blank" class="resource_link u-position-absolute w-inline-block"></a><div class="card is-white is-marquee_review u-zindex-2 u-vflex-left-between u-height-full u-width-full"><div class="u-hflex-left-center w-condition-invisible u-gap-gutter"><img loading="lazy" src="https://cdn.prod.website-files.com/plugins/Basic/assets/placeholder.60f9b1840c.svg" alt="" class="logo is-max_height is-2rem w-dyn-bind-empty"/><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e81176ba2c39/691f88d258686e57206b32c2_5stars.svg" alt="" class="logo is-max_height is-2rem"/></div><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/63d03b9f300e4c9604629e64_62e28cf08913e83153ba2c56_604d40693fdf20831725173b_alegeus.avif" alt="" class="logo is-max_height is-2rem"/><div data-padding-top="1.5" class="u-vflex-left-center"><div class="u-text-style-small">“Before implementing Tonic, our QA and development environments looked nothing like production. Tonic removed a major blocker for us by enabling our teams to test at scale with data that mirrors the size, shape, and feel of our production data. And by guaranteeing privacy for HIPAA compliance, Tonic allows us to share that data safely with our off-shore development teams, too.”</div></div><div data-padding-top="main" class="u-hflex-between-bottom u-overflow-clip u-width-full"><div class="u-vflex-left-bottom"><div class="u-text-style-small margin-none u-weight-medium">Nemo Nemeth</div><div class="u-text-style-tiny margin-none">Head of Data Products</div></div><div class="button_wrap"><a href="https://www.tonic.ai/case-study/how-alegeus-shortens-sprints-to-deploy-healthtech-at-speed-with-tonic" aria-label="" data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d98_instance-5:c3a0ee47-85f2-8410-3ea0-5b3d476c853b_instance-5" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="c3a0ee47-85f2-8410-3ea0-5b3d476c853b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%2264beea08e8bd5cee590e4247%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%2C%7B%22componentId%22%3A%22c3a0ee47-85f2-8410-3ea0-5b3d476c853b%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d98%22%7D%5D" class="underline-button w-button">Read review</a></div></div></div><div class="active_cs_outline is-reviews_outline u-radius-small u-cover-absolute"></div></div><div role="listitem" class="review_item w-dyn-item u-position-relative"><a data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d8b_instance-6" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="318937f0-ae3d-0d73-ff2e-91d0fabf8d8b" data-wf-cms-context="%5B%7B%22collectionId%22%3A%2264beea08e8bd5cee590e3df9%22%2C%22itemId%22%3A%226908d31c07c1b5fef0ea204c%22%7D%5D" data-wf-component-context="%5B%7B%22componentId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d82%22%2C%22instanceId%22%3A%22318937f0-ae3d-0d73-ff2e-91d0fabf8d81%22%7D%5D" href="https://www.tonic.ai/case-study/itedium-lowers-cloud-costs-while-beefing-up-data-security-with-tonic" target="_blank" class="resource_link u-position-absolute w-inline-block"></a><div class="card is-white is-marquee_review u-zindex-2 u-vflex-left-between u-height-full u-width-full"><div class="u-hflex-left-center w-condition-invisible u-gap-gutter"><img loading="lazy" src="https://cdn.prod.website-files.com/plugins/Basic/assets/placeholder.60f9b1840c.svg" alt="" class="logo is-max_height is-2rem w-dyn-bind-empty"/><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e81176ba2c39/691f88d258686e57206b32c2_5stars.svg" alt="" class="logo is-max_height is-2rem"/></div><img loading="lazy" src="https://cdn.prod.website-files.com/62e28cf08913e80aefba2c44/63d03b9e79cb5bf4134057a8_62e28cf08913e84647ba2cfe_6227ffebd6ac419832fc2416_unnamed-2.avif" alt="" class="logo is-max_height is-2rem"/><div data-padding-top="1.5" class="u-vflex-left-center"><div class="u-text-style-small">“Thanks to Tonic Structural, we’re always testing with the latest version of our production schema and masked data. I don’t have to do anything special to make it work.”</div></div><div data-padding-top="main" class="u-hflex-between-bottom u-overflow-clip u-width-full"><div class="u-vflex-left-bottom"><div class="u-text-style-small margin-none u-weight-medium">Youssuf Elkalay</div><div class="u-text-style-tiny margin-none">Executive Engineer</div></div><div class="button_wrap"><a href="https://www.tonic.ai/case-study/itedium-lowers-cloud-costs-while-beefing-up-data-security-with-tonic" aria-label="" data-wf-native-id-path="318937f0-ae3d-0d73-ff2e-91d0fabf8d81:318937f0-ae3d-0d73-ff2e-91d0fabf8d98_instance-6:c3a0ee47-85f2-8410-3ea0-5b3d4