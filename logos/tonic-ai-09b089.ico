  // 1. Define your target domain
  const targetDomain = "fabricate.tonic.ai";
  
  // 2. Optimized Cookie Reader
  function getCookie(name) {
    let nameEQ = name + "=";
    let ca = document.cookie.split(';');
    for (let i = 0; i < ca.length; i++) {
      let c = ca[i].trim();
      if (c.indexOf(nameEQ) == 0) return decodeURIComponent(c.substring(nameEQ.length, c.length));
    }
    return null;
  }
  
  // 3. Updated parameter list to match your existing Setter
  const paramsToTrack = [
    'utm_source', 
    'utm_medium', 
    'utm_campaign', 
    'utm_term', 
    'utm_content', 
    'pid', 
    'ref'
  ];
  
  // 4. Function to update links
  function updateLinks() {
    const links = document.querySelectorAll('a');
    let updatedCount = 0;
    
    links.forEach(link => {
      // Check if link exists, hasn't been processed, and contains your target domain
      if (link.href && link.href.includes(targetDomain) && !link.hasAttribute('data-utm-processed')) {
        try {
          let url = new URL(link.href);
          let hasChanges = false;
          
          paramsToTrack.forEach(param => {
            let cookieValue = getCookie(param);
            if (cookieValue && !url.searchParams.has(param)) {
              // Only add if parameter doesn't already exist
              url.searchParams.set(param, cookieValue);
              hasChanges = true;
            }
          });
          
          if (hasChanges) {
            // Update the link href with the new URL containing the parameters
            link.href = url.toString();
            link.setAttribute('data-utm-processed', 'true');
            updatedCount++;
          }
        } catch (e) {
          // Silently skip links that aren't valid URLs (like mailto: or tel:)
          console.warn("Skipping non-standard link:", link.href);
        }
      }
    });
    
    if (updatedCount > 0) {
      console.log('Updated ' + updatedCount + ' Fabricate links with UTM parameters');
    }
  }
  
  // 5. Run immediately (for initial page load)
  updateLinks();
  
  // 6. Also run on DOMContentLoaded (backup for slow-loading content)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateLinks);
  }
  
  // 7. Run again after a short delay (catches Webflow interactions/animations)
  setTimeout(updateLinks, 500);
  
  // 8. Watch for dynamically added links (Webflow interactions, CMS, etc.)
  if (window.MutationObserver) {
    const observer = new MutationObserver(function(mutations) {
      let shouldUpdate = false;
      mutations.forEach(function(mutation) {
        if (mutation.addedNodes.length > 0) {
          shouldUpdate = true;
        }
      });
      if (shouldUpdate) {
        updateLinks();
      }
    });
    
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  }
  
  // 9. Webflow-specific: Re-run on page transition (if using Webflow IX2 page transitions)
  if (window.Webflow) {
    window.Webflow.push(function() {
      updateLinks();
    });
  }
})();
</script>
<!-- end UTM auto-append script -->

