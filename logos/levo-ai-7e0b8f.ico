<!-- Navbar -->
<script>
  window.addEventListener('scroll', function () {
    const navbar = document.getElementById('navbar');
    const navWrapper = document.getElementById('nav-wrapper');

    if (window.scrollY > 10) {
      navbar.classList.add('scrolled');
      navWrapper.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
      navWrapper.classList.remove('scrolled');
    }
  });
</script>

<!-- Button Accessibility -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const buttonLinks = document.querySelectorAll('a[role="button"]');

  buttonLinks.forEach(function (el) {
    // Ensure it's focusable
    el.setAttribute('tabindex', '0');

    // Prevent default if href is present and just used for JS
    if (el.getAttribute('href') === '#' || el.getAttribute('href') === '') {
      el.addEventListener('click', function (e) {
        e.preventDefault();
      });
    }

    // Add keyboard support for Enter and Space
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault(); // Prevent page scrolling on Space
        el.click(); // Trigger the click event
      }
    });
  });
});
</script>
