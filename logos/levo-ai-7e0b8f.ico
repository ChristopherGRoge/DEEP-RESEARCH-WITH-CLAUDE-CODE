<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>404 - Hideout Found</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

<div id="hideout-wrap">
  <!-- Headline -->
  <div class="headline">
    <h1>You found a hideout</h1>
    <p>We lit it up!</p>
  </div>

  <!-- Scene -->
  <div id="scene">
    <svg viewBox="0 0 1200 675" width="100%" height="100%"
         preserveAspectRatio="xMidYMid meet" role="img"
         aria-labelledby="title desc">
      <title id="title">Levo lights up the hideout</title>
      <desc id="desc">Spotlight reveals 404 over a background 200 within a grid.</desc>

      <!-- THEME -->
      <defs>
        <radialGradient id="spotGrad" r="1">
          <stop offset="0%" stop-color="white" stop-opacity="1"/>
          <stop offset="58%" stop-color="white" stop-opacity=".8"/>
          <stop offset="100%" stop-color="white" stop-opacity="0"/>
        </radialGradient>
        <mask id="spotMask">
          <circle id="spotCircle" cx="0" cy="0" r="220" fill="url(#spotGrad)"/>
        </mask>
        <circle id="node" r="5"/>
      </defs>

      <!-- DIM GRID -->
      <g stroke="#2A2F33" stroke-width="22" opacity=".475" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 150 H1140 M60 255 H1140 M60 360 H1140 M60 465 H1140 M60 570 H1140"/>
        <path d="M140 90 V615 M330 90 V615 M520 90 V615 M710 90 V615 M900 90 V615 M1090 90 V615"/>
      </g>

      <!-- DIM CODE = 200 -->
      <g stroke="#2A2F33" stroke-width="22" opacity=".95" fill="none" stroke-linecap="round" stroke-linejoin="round">

        <!-- "2" (rounded) -->
        <path d="M240 240 
                 Q240 210 270 210 H300 Q330 210 330 240 V300 
                 Q330 330 300 330 H270 Q240 330 240 360 V420 
                 Q240 450 270 450 H300 Q330 450 330 420" />

        <!-- "0" -->
        <rect x="555" y="210" width="90" height="240" rx="32" ry="32"/>

        <!-- "0" -->
        <rect x="860" y="210" width="90" height="240" rx="32" ry="32"/>
      </g>

      <!-- DIM NODES -->
      <g fill="#3A3F44" opacity=".95">
        <use href="#node" x="140" y="150"/><use href="#node" x="330" y="465"/>
        <use href="#node" x="520" y="255"/><use href="#node" x="710" y="570"/>
        <use href="#node" x="900" y="255"/><use href="#node" x="1090" y="360"/>
      </g>

      <!-- LIT GRID -->
      <g stroke="#C7D1D8" stroke-width="2.5" opacity="1" style="mask:url(#spotMask)">
        <path d="M60 150 H1140 M60 255 H1140 M60 360 H1140 M60 465 H1140 M60 570 H1140"/>
        <path d="M140 90 V615 M330 90 V615 M520 90 V615 M710 90 V615 M900 90 V615 M1090 90 V615"/>
      </g>

      <!-- LIT CODE = 404 -->
      <g stroke="#FF5A19" stroke-width="22" opacity="1" style="mask:url(#spotMask)" fill="none" stroke-linecap="round" stroke-linejoin="round">

        <!-- "4" (rounded) -->
        <path d="M240 240 V330 H330 V210 V450" />

        <!-- "0" -->
        <rect x="555" y="210" width="90" height="240" rx="32" ry="32"/>

        <!-- "4" (rounded) -->
        <path d="M860 240 V330 H950 V210 V450" />
      </g>

      <!-- LIT NODES -->
      <g fill="#EEF3F6" opacity="1" style="mask:url(#spotMask)">
        <use href="#node" x="140" y="150"/><use href="#node" x="330" y="465"/>
        <use href="#node" x="520" y="255"/><use href="#node" x="710" y="570"/>
        <use href="#node" x="900" y="255"/><use href="#node" x="1090" y="360"/>
      </g>
    </svg>
  </div>

  <!-- Body (moved outside grid) -->
  <div class="body-text">
    <p>Levo finds vulnerabilities faster than you found this missing page</p>
  </div>

  <!-- CTA -->
  <div class="cta">
    <a href="/">Back to Runtime</a>
    <a href="/book-demo">Book a Demo</a>
  </div>
</div>

<style>
body {
  margin: 0;
  padding-top: 40px; /* offset for navbar height */
  min-height: 100vh;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

/* Global font */
#hideout-wrap, #hideout-wrap * {
  font-family: 'Poppins', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif !important;
}

/* Container */
#hideout-wrap {
  width:100vw; 
  margin:0 auto;
  padding:clamp(16px,3.5vw,44px);
  color:#E5E7EB; background:#0B0B0C;
  box-shadow:0 18px 60px rgba(0,0,0,.35);
}

/* Headline */
.headline { text-align:center; margin-bottom:clamp(10px,1.4vw,18px); }
.headline h1 { margin:0 0 .5em; font-weight:800; line-height:1.15; font-size:clamp(22px,3.2vw,42px); }
.headline p  { margin:0; opacity:.9; font-weight:600; font-size:clamp(14px,1.4vw,20px); }

/* Scene */
#scene {
  position:relative; width:100%;
  aspect-ratio:16/9; max-height:clamp(220px,52vh,560px);
  border-radius:clamp(12px,1.1vw,16px);
  overflow:hidden; background:#0B0B0C; border:1px solid #1C1C1E;
}

/* Body caption (now normal flow, centered) */
.body-text {
  margin-top:clamp(12px,1.6vw,20px);
  text-align:center;
}
.body-text p {
  margin:0 auto;
  padding:clamp(8px,.8vw,12px) clamp(12px,1.2vw,16px);
  border:1px solid #232427; background:rgba(11,11,12,.55);
  backdrop-filter:blur(5px);
  border-radius:clamp(10px,.9vw,14px);
  font-size:clamp(13px,1.3vw,18px); opacity:.95;
  max-width:min(90%,720px);
}

/* CTA */
.cta {
  display:flex; gap:clamp(8px,1vw,14px); justify-content:center;
  margin-top:clamp(14px,2vw,22px); flex-wrap:wrap;
}
.cta a {
  text-decoration:none; display:inline-flex; align-items:center; justify-content:center;
  padding:clamp(10px,.8vw,12px) clamp(14px,1.2vw,18px);
  min-height:44px; min-width:140px; border-radius:clamp(10px,.9vw,14px);
  font-size:clamp(12px,1.2vw,16px); line-height:1.2;
  transition: all 0.3s ease;
}
.cta a:first-child { border:1px solid #2A2A2A; color:#E5E7EB; }
.cta a:first-child:hover { border-color:#3A3A3A; background:rgba(255,255,255,.05); }
.cta a:last-child  { background:#FF5A19; color:#FFFFFF; font-weight:700; }
.cta a:last-child:hover { background:#FF6B2E; transform: translateY(-1px); }

/* Spotlight sweep animation */
@keyframes sweep {
  0%   { transform: translate(110px,540px); }
  25%  { transform: translate(360px,240px); }
  55%  { transform: translate(660px,360px); }
  80%  { transform: translate(960px,220px); }
  100% { transform: translate(1090px,520px); }
}
#spotCircle{
  transform-box: fill-box;
  transform-origin: center;
  animation: sweep 4.8s ease-in-out infinite alternate;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  #spotCircle { animation: none; }
  .cta a { transition: none; }
}

/* Responsive tweaks */

@media (max-width: 1512px){
	#hideout-wrap{ width:100vw; } 
    .utility-page_component{
    margin-top: 60px !important;
    height: auto !important;
	}
}

@media (max-width: 1440px){ 
	#hideout-wrap{ width:100vw; } 
    .utility-page_component{
    margin-top: 60px !important;
	}
 }

@media (max-width: 1024px){ 
	#hideout-wrap{ width:100%; } 
    .utility-page_component{
  	padding: 0 !important;
    height: auto;
    margin-top: 60px !important;
    display: block;
	}
 }
@media (max-width: 768px){
  #hideout-wrap{ width: 100%; }
  #scene{ max-height:56vh; }
    .utility-page_component{
  	padding: 0 !important;
    height: auto;
    margin-top: 40px !important;
    display: block;
	}
}
@media (max-width: 480px){
  #hideout-wrap{ width: 100%; }
  .cta a{ width:100%; }
  
  .utility-page_component{
  	padding: 0 !important;
    height: auto;
    margin-top: 40px !important;
    display: block;
	}
}
</style>

<script>
(() => {
  const scene = document.getElementById('scene');
  const spotCircle = document.getElementById('spotCircle');
  scene.addEventListener('click', () => {
    spotCircle.style.animation = 'none';
    spotCircle.offsetHeight; // reflow
    spotCircle.style.animation = '';
  }, { passive: true });
})();
</script>

</body>
