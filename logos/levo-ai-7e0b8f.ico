<script>
// Copy attribution (all selections, with UTM)
// Appends: "Source : Levo.ai - {title} - {url}"
document.addEventListener("copy", function (e) {
  try {
    const t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;

    const sel = window.getSelection();
    if (!sel || sel.rangeCount === 0 || !sel.toString().trim()) return;

    // Build URL with /?utm_source=CarbonContent, prefer canonical
    const c = document.querySelector('link[rel="canonical"]');
    const raw = (c && c.href) || location.href;
    let url;
    try {
      const u = new URL(raw);
      u.hash = "";
      if (!u.pathname.endsWith("/")) u.pathname += "/";
      u.searchParams.set("utm_source", "CarbonContent");
      url = u.toString();
    } catch (_) {
      // Explicit fallback as requested
      url = "levo.ai/?utm_source=CarbonContent";
    }

    const title = document.title || "Levo.ai";

    // Preserve rich formatting for HTML paste targets
    const box = document.createElement("div");
    for (let i = 0; i < sel.rangeCount; i++) box.appendChild(sel.getRangeAt(i).cloneContents());
    const htmlSelection = box.innerHTML;

    const footerText = "\n\nSource : Levo.ai - " + title + " - " + url;
    const footerHtml =
      '<br><br><div style="font-size:12px;opacity:.75;border-top:1px solid #e5e5e5;padding-top:8px;margin-top:8px">' +
      'Source : Levo.ai - <a href="' + url + '">' + title + "</a></div>";

    const cd = e.clipboardData || window.clipboardData;
    if (!cd) return;

    cd.setData("text/plain", sel.toString() + footerText);
    cd.setData && cd.setData("text/html", htmlSelection + footerHtml);
    e.preventDefault();
  } catch (_) { /* never block copy */ }
}, false);
</script><script src="https://hubspotonwebflow.com/assets/js/form-124.js" type="text/javascript" integrity="sha384-bjyNIOqAKScdeQ3THsDZLGagNN56B4X2Auu9YZIGu+tA/PlggMk4jbWruG/P6zYj" crossorigin="anonymous"></script><script src="https://hubspotv2.use1-marketplace-1p-apps-prod-red.if.webflow.services/static/loader.js" type="text/javascript" async="" defer=""></script><script src="https://hubspotv2.use1-marketplace-1p-apps-prod-red.if.webflow.services/static/disable-hubspot-chatbot.js" type="text/javascript" async="" defer=""></script><script src="https://js.hs-scripts.com/20311278.js" type="text/javascript" async="" defer=""></script></body></html>