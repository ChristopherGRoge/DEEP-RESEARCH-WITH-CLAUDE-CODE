#!/bin/bash

# Skip if this is already a backup-only push (prevent infinite loop)
LAST_COMMIT_MSG=$(git log -1 --format=%s 2>/dev/null)
if [[ "$LAST_COMMIT_MSG" == "chore: auto-backup database before push" ]]; then
    exit 0
fi

echo "Creating database backup before push..."
npm run db:backup --silent

# Stage the new backup
git add backups/*.sql.gz 2>/dev/null || true

# Check if there are backup changes to commit
if ! git diff --cached --quiet backups/; then
    git commit -m "chore: auto-backup database before push" --no-verify
fi
